# Copy to .env.docker and chmod 600. Never commit the resulting file.
# Generate a URL-safe random hex password, then copy it into DATABASE_URL below.
POSTGRES_PASSWORD=
DATABASE_URL=
JWT_SECRET_KEY=
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL_FAST=gemini-2.5-flash
KG_EMBEDDING_PROVIDER=gemini
KG_EMBEDDING_MODEL=gemini-embedding-001
KG_EMBEDDING_DIMENSION=3072
MICCO_IMAGE_TAG=local
MICCO_VCS_REF=unknown
MICCO_BIND_ADDRESS=127.0.0.1
MICCO_HTTP_PORT=18890
# Only for an empty DB. Existing legacy DBs need reviewed migrations first.
AUTO_CREATE_TABLES=true
